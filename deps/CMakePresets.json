{
    "version": 3,
    "configurePresets": [
        {
          "name": "default",
          "displayName": "Default Config",
          "description": "Default build for any desktop OS",
          "binaryDir": "${sourceDir}/build-default",
          "condition": {
            "type": "const",
            "value": true
          },
          "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release",
            "DEP_WX_GTK3": true,
            "DEP_DOWNLOAD_DIR": {
                "type": "PATH",
                "value": "${sourceDir}/.pkg_cache"
            }
          }
        },
        {
            "name": "no-occt",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-no-occt",
            "cacheVariables": {
                "PrusaSlicer_deps_PACKAGE_EXCLUDES": "OCCT"
            }
        },
        {
            "name": "mac_universal_x86",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-x86_64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            }
        },
        {
            "name": "mac_universal_arm",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-arm64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "fast-base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "DEP_DEBUG": false,
                "DEP_MAX_THREADS": "2",
                "DEP_WX_GTK3": true,
                "PrusaSlicer_deps_LEAN_BOOST": true,
                "DEP_DOWNLOAD_DIR": {
                    "type": "PATH",
                    "value": "${sourceDir}/.pkg_cache"
                },
                "PrusaSlicer_deps_SELECT_ALL": false
            }
        },
        {
            "name": "fast-gui",
            "displayName": "Fast GUI dependencies",
            "description": "Release-only runtime dependency closure without tests or OCCT",
            "inherits": "fast-base",
            "binaryDir": "${sourceDir}/build-fast-gui",
            "cacheVariables": {
                "PrusaSlicer_deps_ROOTS": "Boost;CGAL;CURL;Cereal;EXPAT;Eigen;GLEW;JPEG;LibBGCode;NLopt;NanoSVG;OpenVDB;PNG;Qhull;TBB;ZLIB;json;wxWidgets;z3"
            }
        },
        {
            "name": "lean-release",
            "displayName": "Full-feature Release dependencies",
            "description": "Release-only dependency closure including GUI, STEP and tests",
            "inherits": "fast-base",
            "binaryDir": "${sourceDir}/build-lean-release",
            "cacheVariables": {
                "PrusaSlicer_deps_ROOTS": "Boost;CGAL;CURL;Catch2;Cereal;EXPAT;Eigen;GLEW;JPEG;LibBGCode;NLopt;NanoSVG;OCCT;OpenVDB;PNG;Qhull;TBB;ZLIB;json;wxWidgets;z3"
            }
        },
        {
            "name": "fast-cli",
            "displayName": "Lean CLI dependencies",
            "description": "Release-only transitive closure with GUI, test, and OCCT packages removed",
            "inherits": "fast-base",
            "binaryDir": "${sourceDir}/build-fast-cli",
            "cacheVariables": {
                "PrusaSlicer_deps_ROOTS": "Boost;CGAL;Cereal;EXPAT;Eigen;JPEG;LibBGCode;NLopt;NanoSVG;OpenVDB;PNG;Qhull;TBB;ZLIB;json;z3"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "fast-gui",
            "configurePreset": "fast-gui",
            "jobs": 2,
            "environment": {"CMAKE_BUILD_PARALLEL_LEVEL": "2"},
            "targets": ["deps"]
        },
        {
            "name": "fast-cli",
            "configurePreset": "fast-cli",
            "jobs": 2,
            "environment": {"CMAKE_BUILD_PARALLEL_LEVEL": "2"},
            "targets": ["deps"]
        },
        {
            "name": "lean-release",
            "configurePreset": "lean-release",
            "jobs": 2,
            "environment": {"CMAKE_BUILD_PARALLEL_LEVEL": "2"},
            "targets": ["deps"]
        }
    ]
}
