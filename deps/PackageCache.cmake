# Optional verified, same-prefix package reuse. Never executes cache-supplied code.
set(PrusaSlicer_deps_CACHE_SELECTION "" CACHE FILEPATH "Verified package-cache selection JSON (normally managed by build_fast.ps1)")

function(prusaslicer_verify_cached_package selection package)
  if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "Package cache reuse requires CMake 3.19 or newer")
  endif()
  file(READ "${selection}" _selection)
  string(JSON _schema GET "${_selection}" schema)
  if(NOT _schema EQUAL 1)
    message(FATAL_ERROR "Unsupported package selection schema")
  endif()
  string(JSON _prefix GET "${_selection}" installPrefix)
  file(TO_CMAKE_PATH "${PrusaSlicer_deps_DEP_INSTALL_PREFIX}" _expected_prefix)
  string(TOLOWER "${_expected_prefix}" _expected_prefix)
  if(NOT _prefix STREQUAL _expected_prefix)
    message(FATAL_ERROR "Package cache install-prefix mismatch")
  endif()
  string(JSON _manifest_path GET "${_selection}" hits "${package}" manifest)
  string(JSON _expected_manifest GET "${_selection}" hits "${package}" sha256)
  file(SHA256 "${_manifest_path}" _manifest_hash)
  if(NOT _manifest_hash STREQUAL _expected_manifest)
    message(FATAL_ERROR "Package cache manifest changed: ${package}")
  endif()
  file(READ "${_manifest_path}" _manifest)
  string(JSON _schema GET "${_manifest}" schema)
  if(NOT _schema EQUAL 1)
    message(FATAL_ERROR "Unsupported package manifest schema")
  endif()
  string(JSON _key GET "${_manifest}" fingerprint)
  string(JSON _current_key GET "${_selection}" fingerprints "${package}")
  string(JSON _name GET "${_manifest}" package)
  string(JSON _manifest_prefix GET "${_manifest}" installPrefix)
  get_filename_component(_entry "${_manifest_path}" DIRECTORY)
  file(SHA256 "${_entry}/input.json" _input_hash)
  if(NOT _key STREQUAL _current_key OR NOT _input_hash STREQUAL _key OR
      NOT _name STREQUAL package OR NOT _manifest_prefix STREQUAL _prefix)
    message(FATAL_ERROR "Package cache identity mismatch: ${package}")
  endif()
  file(READ "${_entry}/input.json" _input)
  # Recheck source inputs/options when an existing Ninja tree regenerates.
  foreach(_field IN ITEMS recipeInputs commonInputs dependencyInputs)
    string(JSON _count LENGTH "${_input}" ${_field})
    if(_count GREATER 0)
      math(EXPR _last "${_count} - 1")
      foreach(_index RANGE ${_last})
        string(JSON _path GET "${_input}" ${_field} ${_index} path)
        string(JSON _expected GET "${_input}" ${_field} ${_index} sha256)
        if(NOT EXISTS "${_path}" OR IS_SYMLINK "${_path}")
          message(FATAL_ERROR "Missing/linked cache recipe input: ${_path}")
        endif()
        file(SHA256 "${_path}" _actual)
        if(NOT _actual STREQUAL _expected)
          message(FATAL_ERROR "Cache recipe changed; rerun build_fast.ps1: ${_path}")
        endif()
      endforeach()
    endif()
  endforeach()
  if(NOT PRUSASLICER_CACHE_BUILD_CHECK)
    string(JSON _count LENGTH "${_input}" effectiveCMake)
    if(_count GREATER 0)
      math(EXPR _last "${_count} - 1")
      foreach(_index RANGE ${_last})
        string(JSON _name MEMBER "${_input}" effectiveCMake ${_index})
        string(JSON _value GET "${_input}" effectiveCMake "${_name}")
        set(_actual_option "${${_name}}")
        if(_name STREQUAL "CMAKE_MSVC_RUNTIME_LIBRARY" AND NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
          set(_actual_option "MultiThreadedDLL (CMake default for Release)")
        endif()
        if(NOT "${_actual_option}" STREQUAL "${_value}")
          message(FATAL_ERROR "Cache option ${_name} changed; rerun build_fast.ps1")
        endif()
      endforeach()
    endif()
    string(JSON _count LENGTH "${_input}" dependencies)
    set(_children "")
    if(_count GREATER 0)
      math(EXPR _last "${_count} - 1")
      foreach(_index RANGE ${_last})
        string(JSON _name MEMBER "${_input}" dependencies ${_index})
        string(JSON _value GET "${_input}" dependencies "${_name}")
        string(JSON _current GET "${_selection}" fingerprints "${_name}")
        if(NOT _value STREQUAL _current)
          message(FATAL_ERROR "Transitive cache dependency mismatch: ${package}/${_name}")
        endif()
        list(APPEND _children "${_name}")
      endforeach()
    endif()
    set(_expected_children ${DEP_${package}_DEPENDS})
    list(SORT _expected_children)
    list(SORT _children)
    if(NOT "${_children}" STREQUAL "${_expected_children}")
      message(FATAL_ERROR "Cached dependency edges changed: ${package}")
    endif()
    string(JSON _count LENGTH "${_input}" dependencyEdges)
    if(_count GREATER 0)
      math(EXPR _last "${_count} - 1")
      foreach(_index RANGE ${_last})
        string(JSON _name MEMBER "${_input}" dependencyEdges ${_index})
        string(JSON _edge_count LENGTH "${_input}" dependencyEdges "${_name}")
        set(_children "")
        if(_edge_count GREATER 0)
          math(EXPR _edge_last "${_edge_count} - 1")
          foreach(_edge_index RANGE ${_edge_last})
            string(JSON _child GET "${_input}" dependencyEdges "${_name}" ${_edge_index})
            list(APPEND _children "${_child}")
          endforeach()
        endif()
        set(_expected_children ${DEP_${_name}_DEPENDS})
        list(SORT _expected_children)
        list(SORT _children)
        if(NOT "${_children}" STREQUAL "${_expected_children}")
          message(FATAL_ERROR "Transitive cached dependency edges changed: ${package}/${_name}")
        endif()
      endforeach()
    endif()
  endif()
  string(JSON _count LENGTH "${_manifest}" files)
  if(_count LESS 1)
    message(FATAL_ERROR "Empty package cache artifact: ${package}")
  endif()
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE ${_last})
    string(JSON _relative GET "${_manifest}" files ${_index} path)
    string(JSON _expected GET "${_manifest}" files ${_index} sha256)
    if(_relative MATCHES "(^/|\\\\|:|(^|/)\\.\\.?(/|$)|//)")
      message(FATAL_ERROR "Unsafe cached payload path: ${_relative}")
    endif()
    set(_path "${_prefix}/${_relative}")
    get_filename_component(_real "${_path}" REALPATH)
    string(TOLOWER "${_real}" _real)
    string(FIND "${_real}" "${_prefix}/" _inside)
    if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}" OR IS_SYMLINK "${_path}" OR NOT _inside EQUAL 0)
      message(FATAL_ERROR "Cached payload missing or redirected: ${_relative}")
    endif()
    file(SHA256 "${_path}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Cached payload changed: ${_relative}")
    endif()
  endforeach()
endfunction()

macro(prusaslicer_load_package_cache)
  set(PRUSASLICER_CACHED_PACKAGES "")
  if(PrusaSlicer_deps_CACHE_SELECTION)
    if(LibBGCode_SOURCE_DIR)
      message(FATAL_ERROR "Package cache selection cannot replace an always-built local LibBGCode source")
    endif()
    if(CMAKE_VERSION VERSION_LESS 3.19)
      message(FATAL_ERROR "Package cache reuse requires CMake 3.19 or newer")
    endif()
    if(NOT MSVC OR NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR DEP_DEBUG OR BUILD_SHARED_LIBS)
      message(FATAL_ERROR "Package cache targets support native MSVC Release-only builds")
    endif()
    file(READ "${PrusaSlicer_deps_CACHE_SELECTION}" _cache_selection)
    string(JSON _cache_count LENGTH "${_cache_selection}" hits)
    if(_cache_count GREATER 0)
      math(EXPR _cache_last "${_cache_count} - 1")
      foreach(_cache_index RANGE ${_cache_last})
        string(JSON _cache_package MEMBER "${_cache_selection}" hits ${_cache_index})
        if(NOT _cache_package IN_LIST FOUND_PACKAGES OR
            (PrusaSlicer_deps_ROOTS AND NOT _cache_package IN_LIST _selected_packages))
          message(FATAL_ERROR "Cached package is not selected: ${_cache_package}")
        endif()
        prusaslicer_verify_cached_package("${PrusaSlicer_deps_CACHE_SELECTION}" "${_cache_package}")
        list(APPEND PRUSASLICER_CACHED_PACKAGES "${_cache_package}")
      endforeach()
    endif()
  endif()
endmacro()

function(prusaslicer_add_cached_package package)
  add_custom_target(dep_${package}
    COMMAND "${CMAKE_COMMAND}"
      "-DPrusaSlicer_deps_DEP_INSTALL_PREFIX=${PrusaSlicer_deps_DEP_INSTALL_PREFIX}"
      "-DPRUSASLICER_CACHE_SELECTION=${PrusaSlicer_deps_CACHE_SELECTION}"
      "-DPRUSASLICER_CACHE_PACKAGE=${package}"
      -DPRUSASLICER_CACHE_BUILD_CHECK=ON -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
    COMMENT "Verifying cached dependency ${package}" VERBATIM)
endfunction()

if(PRUSASLICER_CACHE_BUILD_CHECK)
  prusaslicer_verify_cached_package("${PRUSASLICER_CACHE_SELECTION}" "${PRUSASLICER_CACHE_PACKAGE}")
endif()
